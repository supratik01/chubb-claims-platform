{
  "name": "claims-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve shell",
    "start:claimant": "ng serve claimant",
    "start:staff": "ng serve staff",
    "generate:api": "npx -y openapi-typescript@7.13.0 ../backend/src/main/resources/openapi/claims-api.yaml -o projects/shared/src/lib/api/claims-api.generated.ts",
    "build": "ng build shell && ng build claimant && ng build staff",
    "test": "ng test shared --watch=false && ng test shell --watch=false && ng test claimant --watch=false && ng test staff --watch=false",
    "e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "es-module-shims": "^2.8.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "^22.2.5",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.65.1",
    "@softarc/native-federation-orchestrator": "^4.10.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
