{
  "info": {
    "name": "Chubb APAC Claims API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Manual and scripted checks of the claims API, in the order of the demo flow. Run the folders top to bottom (or `postman collection run postman/claims-api.postman_collection.json`) against a stack started with `docker compose up`. The contract is backend/src/main/resources/openapi/claims-api.yaml."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4200/api/v1"
    },
    {
      "key": "demoPassword",
      "value": "Demo-Passw0rd!"
    },
    {
      "key": "claimantToken",
      "value": ""
    },
    {
      "key": "officerToken",
      "value": ""
    },
    {
      "key": "managerToken",
      "value": ""
    },
    {
      "key": "policyId",
      "value": ""
    },
    {
      "key": "claimId",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "incidentDate",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Sign in",
      "item": [
        {
          "name": "Sign in as claimant.mei",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"claimant.mei\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('claimantToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in as officer.sam",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"officer.sam\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('officerToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in as manager.kenji",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"manager.kenji\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('managerToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong password is refused",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"claimant.mei\",\n  \"password\": \"not-the-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 401', () => pm.response.to.have.status(401));",
                  "pm.test('is a problem document with code INVALID_CREDENTIALS', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json().code).to.eql('INVALID_CREDENTIALS');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Claimant reports an incident",
      "item": [
        {
          "name": "List my policies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{claimantToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/policies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "policies"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const motor = pm.response.json().find(p => p.lineOfBusiness === 'MOTOR');",
                  "pm.test('has a motor policy', () => pm.expect(motor).to.be.an('object'));",
                  "pm.collectionVariables.set('policyId', motor.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Report an incident with missing details",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{claimantToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/claims",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policyId\": \"{{policyId}}\",\n  \"description\": \"short\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 400', () => pm.response.to.have.status(400));",
                  "pm.test('is a problem document with code VALIDATION_FAILED', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json().code).to.eql('VALIDATION_FAILED');",
                  "});",
                  "pm.test('names the invalid fields', () => pm.expect(pm.response.json().errors.map(e => e.field)).to.include.members(['incidentDate', 'description', 'claimedAmount']));"
                ]
              }
            }
          ]
        },
        {
          "name": "Report an incident",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{claimantToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/claims",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policyId\": \"{{policyId}}\",\n  \"incidentDate\": \"{{incidentDate}}\",\n  \"incidentLocation\": \"Orchard Road, Singapore\",\n  \"description\": \"Side mirror broken by a passing van while parked.\",\n  \"claimedAmount\": 650\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const yesterday = new Date(Date.now() - 86400000).toISOString().slice(0, 10);",
                  "pm.collectionVariables.set('incidentDate', yesterday);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 201', () => pm.response.to.have.status(201));",
                  "const claim = pm.response.json();",
                  "pm.test('starts as SUBMITTED with one history entry', () => { pm.expect(claim.status).to.eql('SUBMITTED'); pm.expect(claim.statusHistory).to.have.length(1); });",
                  "pm.test('hides staff-only figures from the claimant', () => pm.expect(claim.reserveAmount).to.eql(null));",
                  "pm.collectionVariables.set('claimId', claim.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List my claims",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{claimantToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/claims",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('includes the new claim', () => pm.expect(pm.response.json().items.map(c => c.id)).to.include(pm.collectionVariables.get('claimId')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Officer works the claim",
      "item": [
        {
          "name": "Unassigned queue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{officerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/claims?assignment=UNASSIGNED",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims"
              ],
              "query": [
                {
                  "key": "assignment",
                  "value": "UNASSIGNED"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('contains the new claim', () => pm.expect(pm.response.json().items.map(c => c.id)).to.include(pm.collectionVariables.get('claimId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pick up the claim",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{officerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/claims/{{claimId}}/assignment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                "{{claimId}}",
                "assignment"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('is UNDER_REVIEW and assigned', () => { pm.expect(pm.response.json().status).to.eql('UNDER_REVIEW'); pm.expect(pm.response.json().assignedOfficerName).to.eql('Sam Lee'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Picking it up again is refused",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{officerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/claims/{{claimId}}/assignment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                "{{claimId}}",
                "assignment"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 409', () => pm.response.to.have.status(409));",
                  "pm.test('is a problem document with code INVALID_STATUS_TRANSITION', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json().code).to.eql('INVALID_STATUS_TRANSITION');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "A claimant cannot pick up a claim",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{claimantToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/claims/{{claimId}}/assignment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                "{{claimId}}",
                "assignment"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 403', () => pm.response.to.have.status(403));",
                  "pm.test('is a problem document with code ACCESS_DENIED', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json().code).to.eql('ACCESS_DENIED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Ask the claimant for information",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{officerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/claims/{{claimId}}/information-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                "{{claimId}}",
                "information-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Do you have a photo of the damage?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "const claim = pm.response.json();",
                  "pm.test('waits on the claimant', () => pm.expect(claim.status).to.eql('INFO_REQUESTED'));",
                  "pm.collectionVariables.set('requestId', claim.informationRequests[0].id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Claimant answers",
      "item": [
        {
          "name": "Answer the question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{claimantToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/claims/{{claimId}}/information-requests/{{requestId}}/response",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                "{{claimId}}",
                "information-requests",
                "{{requestId}}",
                "response"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"response\": \"Yes, I can email it today.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('goes back to review', () => pm.expect(pm.response.json().status).to.eql('UNDER_REVIEW'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Decision and settlement",
      "item": [
        {
          "name": "Approving without an amount is refused",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{officerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/claims/{{claimId}}/decision",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                "{{claimId}}",
                "decision"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"APPROVED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 422', () => pm.response.to.have.status(422));",
                  "pm.test('is a problem document with code BUSINESS_RULE_VIOLATED', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json().code).to.eql('BUSINESS_RULE_VIOLATED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{officerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/claims/{{claimId}}/decision",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                "{{claimId}}",
                "decision"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"APPROVED\",\n  \"approvedAmount\": 600,\n  \"reason\": \"Approved less the excess.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('is APPROVED with the reserve set to the approved amount', () => { pm.expect(pm.response.json().status).to.eql('APPROVED'); pm.expect(pm.response.json().reserveAmount).to.eql(600); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Claimant sees the decision",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{claimantToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/claims/{{claimId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                "{{claimId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('shows the approved amount and reason', () => { pm.expect(pm.response.json().approvedAmount).to.eql(600); pm.expect(pm.response.json().decisionReason).to.eql('Approved less the excess.'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Record the payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{officerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/claims/{{claimId}}/settlement",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                "{{claimId}}",
                "settlement"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('is SETTLED', () => pm.expect(pm.response.json().status).to.eql('SETTLED'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Dashboards",
      "item": [
        {
          "name": "Team workload",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{officerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/workload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard",
                "workload"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('lists officers', () => pm.expect(pm.response.json().officers.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Outstanding exposure (manager)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/exposure",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard",
                "exposure"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('reports totals per currency', () => pm.expect(pm.response.json().totals.map(t => t.currency)).to.include('SGD'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Exposure is for managers only",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{officerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/exposure",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard",
                "exposure"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
