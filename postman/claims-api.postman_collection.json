                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 403', () => pm.response.to.have.status(403));",
                  "pm.test('is a problem document with code ACCESS_DENIED', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json().code).to.eql('ACCESS_DENIED');",
